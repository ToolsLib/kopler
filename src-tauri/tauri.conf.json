{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kopler",
  "version": "0.1.5",
  "identifier": "local.kopler.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kopler",
        "width": 460,
        "height": 640,
        "minWidth": 360,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "decorations": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Notes and next steps, one shortcut away",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBODlFNTZGMzVCNEE2NEIKUldSTHByUTFiK1dKYXY3RzhVbnZ2SEY1Q2hOMEJGcDNqRi9hNDNyREtJUFowcGZsaWM5QVFpU3EK",
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/ToolsLib/kopler/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
