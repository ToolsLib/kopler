{
  "name": "kopler",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test": "vitest run src",
    "test:e2e": "npm run build && playwright test",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "icons": "node scripts/icons.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:windows": "node scripts/release.mjs build windows",
    "release:macos": "node scripts/release.mjs build macos",
    "release:linux": "node scripts/release.mjs build linux",
    "test:release": "node --test tests/release.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tauri-apps/api": "^2",
    "lucide-react": "^0.468.0",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "typescript": "^5.9",
    "vite": "^7",
    "vitest": "^5.1.0"
  }
}
